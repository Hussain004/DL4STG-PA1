# LaTeX: the compiled PDF is committed, the build intermediates are not.
# report.aux stays in the working tree (LaTeX needs it to resolve cross-references
# across passes) but is not tracked, so it creates no merge noise between branches.
*.aux
*.log
*.out
*.synctex.gz
*.toc

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Large working directories: the per-step predictions of every training run.
# They are regenerable with the experiments_*.sh scripts and the Q2_DATA data.
runs/
report_assets/
